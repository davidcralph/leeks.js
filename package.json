{
  "name": "leeks.js",
  "version": "1.0.0",
  "description": "Simple ANSI styling for your terminal",
  "keywords": [
    "color",
    "colour",
    "colors",
    "colours",
    "ansi",
    "style",
    "styles",
    "terminal",
    "console",
    "lightweight",
    "rgb",
    "256"
  ],
  "homepage": "https://leeks.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidcralph/leeks.js.git"
  },
  "license": "MIT",
  "author": "David Ralph",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:watch": "node --test --watch \"src/**/*.test.ts\"",
    "lint:pkg": "publint && attw --pack .",
    "example": "node example/example.mjs && node example/example.cjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.0.0",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
